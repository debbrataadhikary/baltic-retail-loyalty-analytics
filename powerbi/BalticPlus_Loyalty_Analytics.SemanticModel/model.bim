            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"d:\\\\DW- Internship\\\\Lidl-Loyalty-Data-Analyst\\\\baltic-retail-loyalty-analytics\\\\data\\\\processed\\\\dim_stores.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
