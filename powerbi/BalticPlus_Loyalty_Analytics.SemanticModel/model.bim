                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"year\", Int64.Type}, {\"month_num\", Int64.Type}, {\"fiscal_week\", Int64.Type}, {\"is_weekend\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fact_pos_transactions_gold",
        "columns": [
          {
            "name": "transaction_id",
            "dataType": "string",
            "sourceColumn": "transaction_id"
          },
          {
            "name": "transaction_date",
            "dataType": "string",
            "sourceColumn": "transaction_date"
          },
          {
            "name": "fiscal_week",
            "dataType": "int64",
            "sourceColumn": "fiscal_week"
          },
          {
            "name": "country_code",
            "dataType": "string",
            "sourceColumn": "country_code"
          },
          {
            "name": "store_id",
            "dataType": "string",
            "sourceColumn": "store_id"
          },
          {
            "name": "is_loyalty_scan",
            "dataType": "int64",
            "sourceColumn": "is_loyalty_scan"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id"
          },
          {
            "name": "customer_archetype",
            "dataType": "string",
            "sourceColumn": "customer_archetype"
          },
          {
            "name": "coupon_applied",
            "dataType": "int64",
            "sourceColumn": "coupon_applied"
          },
          {
            "name": "campaign_id",
            "dataType": "string",
            "sourceColumn": "campaign_id"
          },
          {
            "name": "items_count",
            "dataType": "int64",
            "sourceColumn": "items_count"
          },
          {
            "name": "promo_item_spend_eur",
            "dataType": "double",
            "sourceColumn": "promo_item_spend_eur"
          },
          {
            "name": "non_promo_halo_spend_eur",
            "dataType": "double",
            "sourceColumn": "non_promo_halo_spend_eur"
          },
          {
            "name": "gross_basket_eur",
            "dataType": "double",
            "sourceColumn": "gross_basket_eur"
          },
          {
            "name": "discount_amount_eur",
            "dataType": "double",
            "sourceColumn": "discount_amount_eur"
          },
          {
            "name": "net_sales_eur",
            "dataType": "double",
            "sourceColumn": "net_sales_eur"
          },
          {
            "name": "net_margin_eur",
            "dataType": "double",
            "sourceColumn": "net_margin_eur"
          },
          {
            "name": "record_status",
            "dataType": "string",
            "sourceColumn": "record_status"
          }
        ],
        "measures": [
          {
            "name": "Total Net Sales (\u20ac)",
            "expression": "SUM(fact_pos_transactions_gold[net_sales_eur])",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Total Validated Baskets",
            "expression": "DISTINCTCOUNT(fact_pos_transactions_gold[transaction_id])",
            "formatString": "#,0"
          },
          {
            "name": "Average Net Basket (\u20ac)",
            "expression": "DIVIDE([Total Net Sales (\u20ac)], [Total Validated Baskets], 0)",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Loyalty App Baskets",
            "expression": "CALCULATE([Total Validated Baskets], fact_pos_transactions_gold[is_loyalty_scan] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "Loyalty Scan Penetration (%)",
            "expression": "DIVIDE([Loyalty App Baskets], [Total Validated Baskets], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Loyalty Basket (\u20ac)",
            "expression": "CALCULATE([Average Net Basket (\u20ac)], fact_pos_transactions_gold[is_loyalty_scan] = 1)",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Avg Guest Basket (\u20ac)",
            "expression": "CALCULATE([Average Net Basket (\u20ac)], fact_pos_transactions_gold[is_loyalty_scan] = 0)",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Loyalty Basket Uplift (\u20ac)",
            "expression": "[Avg Loyalty Basket (\u20ac)] - [Avg Guest Basket (\u20ac)]",
            "formatString": "+\u20ac#,0.00;-\u20ac#,0.00;\u20ac0.00"
          },
          {
            "name": "Avg Attached Halo Spend (\u20ac)",
            "expression": "CALCULATE(AVERAGE(fact_pos_transactions_gold[non_promo_halo_spend_eur]), fact_pos_transactions_gold[coupon_applied] = 1)",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Total Promo Discount Spend (\u20ac)",
            "expression": "SUM(fact_pos_transactions_gold[discount_amount_eur])",
            "formatString": "\u20ac#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "fact_pos_transactions_gold",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"d:\\\\DW- Internship\\\\Lidl-Loyalty-Data-Analyst\\\\baltic-retail-loyalty-analytics\\\\data\\\\processed\\\\fact_pos_transactions_gold.csv\"),[Delimiter=\",\", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"fiscal_week\", Int64.Type}, {\"is_loyalty_scan\", Int64.Type}, {\"coupon_applied\", Int64.Type}, {\"items_count\", Int64.Type}, {\"promo_item_spend_eur\", type number}, {\"non_promo_halo_spend_eur\", type number}, {\"gross_basket_eur\", type number}, {\"discount_amount_eur\", type number}, {\"net_sales_eur\", type number}, {\"net_margin_eur\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
