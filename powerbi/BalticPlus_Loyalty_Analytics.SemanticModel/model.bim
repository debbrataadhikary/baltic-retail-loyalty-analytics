                "let",
                "    Source = Csv.Document(File.Contents(\"d:\\\\DW- Internship\\\\Lidl-Loyalty-Data-Analyst\\\\baltic-retail-loyalty-analytics\\\\reports\\\\baltic_executive_country_kpis.csv\"),[Delimiter=\",\", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
