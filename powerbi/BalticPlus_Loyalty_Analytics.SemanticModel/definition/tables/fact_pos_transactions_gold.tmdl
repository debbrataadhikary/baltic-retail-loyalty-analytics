table fact_pos_transactions_gold
	lineageTag: 87ac5dda-9b1c-4654-899b-a29d1bd4200a

	measure 'Total Net Sales (€)' = SUM(fact_pos_transactions_gold[net_sales_eur])
		formatString: €#,0.00
		lineageTag: ebc5a76c-59a6-4e40-8933-ff14727c2b50

	measure 'Total Validated Baskets' = DISTINCTCOUNT(fact_pos_transactions_gold[transaction_id])
		formatString: #,0
		lineageTag: 7a9ae904-b965-4149-852f-b8a3b8fa64bc

	measure 'Average Net Basket (€)' = DIVIDE([Total Net Sales (€)], [Total Validated Baskets], 0)
		formatString: €#,0.00
		lineageTag: 0c257365-de0a-4613-b53a-b17ace3351bd

	measure 'Loyalty Scan Penetration (%)' = DIVIDE(CALCULATE([Total Validated Baskets], fact_pos_transactions_gold[is_loyalty_scan]=1), [Total Validated Baskets], 0)
		formatString: 0.0%
		lineageTag: 63fcb01b-8c6d-4cff-becf-6fe28065afd1

	measure 'Avg Loyalty Basket (€)' = CALCULATE([Average Net Basket (€)], fact_pos_transactions_gold[is_loyalty_scan]=1)
		formatString: €#,0.00
		lineageTag: fa0e65de-b8ad-4427-8a97-85153048bd38

	measure 'Avg Guest Basket (€)' = CALCULATE([Average Net Basket (€)], fact_pos_transactions_gold[is_loyalty_scan]=0)
		formatString: €#,0.00
		lineageTag: 79bca953-97cd-458f-8acc-518c831f6cbb

	measure 'Loyalty Basket Uplift (€)' = [Avg Loyalty Basket (€)] - [Avg Guest Basket (€)]
		formatString: +€#,0.00;-€#,0.00;€0.00
		lineageTag: e5ae72bf-9bab-4db0-8b8f-a4bb981c6c71

